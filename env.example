# ============================================
# 이메일 발송 설정 (SMTP)
# 아래 값을 .env.local에 복사하고 실제 값으로 채우세요.
# ============================================

# Gmail 사용 시:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-gmail@gmail.com
#   SMTP_PASS=앱 비밀번호 (구글 계정 → 보안 → 앱 비밀번호)

# Naver 사용 시:
#   SMTP_HOST=smtp.naver.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-naver-id@naver.com
#   SMTP_PASS=네이버 비밀번호

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 수신할 이메일 주소 (비워두면 SMTP_USER로 수신)
SMTP_TO=shin7942@sangji.ac.kr
